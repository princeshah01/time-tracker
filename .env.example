# These Env Variables are used to configure the services in the docker compose file

# Postgres Environment Variables

POSTGRES_DB=monorepo
POSTGRES_USER=monorepo
POSTGRES_PASSWORD=monorepo
POSTGRES_PORT=5490
DATABASE_URL=postgres://monorepo:monorepo@localhost:5490/monorepo

# Redis Environment Variables
REDIS_PORT=6379
REDIS_PASSWORD=monorepo

# Redis Commander Environment Variables
REDISCOMMANDER_PORT=8081
# Redis Host is the name of the redis service in the docker compose file
REDIS_HOST=redis
