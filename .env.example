# These Env Variables are used to configure the services in the docker compose file

# Postgres Environment Variables

POSTGRES_DB=time_tracker_db
POSTGRES_USER=time_tracker_user
POSTGRES_PASSWORD=time_tracker_password
POSTGRES_PORT=5434
DATABASE_URL=postgres://time_tracker_user:time_tracker_password@localhost:5434/time_tracker_db

# Redis Environment Variables
REDIS_PORT=6379
REDIS_PASSWORD=time_tracker_password

# Redis Commander Environment Variables
REDISCOMMANDER_PORT=8081
# Redis Host is the name of the redis service in the docker compose file
REDIS_HOST=redis
