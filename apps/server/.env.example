# Microsoft Azure AD configuration
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-new-secret-value
MICROSOFT_TENANT_ID=your-tenant-id
# Database connection string (PostgreSQL in this case)
DATABASE_URL=your-database-url

# node environment (development, production, etc.)
PORT=4000
NODE_ENV=development

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=your-better-auth-secret

# Client URL (for CORS redirect and better auth)
CLIENT_URL=http://localhost:5173

# redis configuration
REDIS_URL=redis://:time_tracker_password@localhost:6379