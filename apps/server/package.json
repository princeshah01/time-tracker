{
  "name": "server",
  "version": "0.0.0",
  "author": "Prince Shah",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seeds/role-permissions.ts",
    "db:seed:dummy": "tsx src/db/seeds/dummy-data.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate-users": "tsx data-migration/migrate-users.ts",
    "db:migrate-clients": "tsx data-migration/migrate-clients.ts",
    "db:migrate-projects": "tsx data-migration/migrate-projects.ts",
    "db:migrate-project-members": "tsx data-migration/migrate-project-members.ts",
    "db:migrate-tasks": "tsx data-migration/migrate-tasks.ts",
    "db:migrate-timesheets": "tsx data-migration/migrate-timesheets.ts",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:worker\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.9",
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "better-auth": "catalog:",
    "bullmq": "^5.76.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "postgres": "catalog:",
    "redis": "^5.12.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.2.1",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "^4.21.0"
  }
}
